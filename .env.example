# ==========================================
# RESUMAI PLATFORM - ENVIRONMENT VARIABLES
# ==========================================

# Supabase Authentication & Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# PostgreSQL Database (Prisma ORM via Supabase or Neon)
# Connection pool URL (port 6543 for Supabase pooler)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection URL (port 5432 for migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Google Gemini AI API Key (Free tier from Google AI Studio)
GEMINI_API_KEY="AIzaSy..."

# Google OAuth / One-Tap Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Public App Base URL (e.g. https://your-project.vercel.app or custom domain)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
